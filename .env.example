# XAI_API_KEY is optional. With it unset, Ask Grok uses the deterministic planner.
# Create a key at https://console.x.ai/ and do not commit it.
XAI_API_KEY=

# Model id sent to the xAI Responses API. Default in code is grok-4.7.
# https://docs.x.ai/developers/models
XAI_MODEL=grok-4.7

# Responses API base. The planner posts to ${XAI_BASE_URL}/responses with store:false.
XAI_BASE_URL=https://api.x.ai/v1

# Per-attempt timeout in milliseconds. Two attempts, then the deterministic planner.
XAI_TIMEOUT_MS=20000

# Open-Meteo stand-in coordinates. These are not the simulated area of operations.
# Default is the Las Vegas area, as a CES weather stand-in.
WEATHER_LAT=36.17
WEATHER_LON=-115.14
WEATHER_LABEL=Las Vegas stand-in (not the simulated area of operations)
